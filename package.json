{
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1015.0",
    "@aws-sdk/s3-request-presigner": "^3.1015.0",
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.2",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "fast-xml-parser": "^5.11.1",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.10.1",
    "joi": "^18.1.1",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.9.4",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.17",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cron": "^2.0.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "openapi-to-postmanv2": "^6.0.0",
    "prisma": "^6.19.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.7"
  },
  "name": "shop-api",
  "version": "0.0.1",
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc --project tsconfig.json",
    "start": "node dist/main",
    "start:dev": "rm -rf dist tsconfig.tsbuildinfo && tsc --project tsconfig.json && node dist/main",
    "start:debug": "rm -rf dist tsconfig.tsbuildinfo && tsc --project tsconfig.json && node --inspect dist/main",
    "start:prod": "node dist/main",
    "openapi:generate": "ts-node scripts/generate-openapi.ts",
    "openapi:validate": "ts-node scripts/validate-openapi.ts",
    "openapi:test": "npm run openapi:generate && npm run openapi:validate",
    "postman:generate": "npm run openapi:generate && ts-node scripts/generate-postman.ts",
    "docs:test": "npm run openapi:generate && npm run openapi:validate && npm run postman:generate",
    "test": "jest"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
